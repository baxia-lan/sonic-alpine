"""Alpine VS platform — BUILD.bazel added on claude branch.

Migration status: Phase 1 Bazel migration.
Build type: GNU Make (.mk rules)

Alpine VS is the virtual switch platform used for testing. It contains
Make-based build rules (.mk/.dep files) that produce Docker images and
platform configuration for the virtual switch environment.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(
        ["**/*"],
        exclude = [".git/**", "build/**"],
    ),
)

filegroup(
    name = "platform_rules",
    srcs = glob(["*.mk", "*.dep", "*.conf"]),
)

genrule(
    name = "alpine_vs_platform",
    srcs = [":all_srcs"],
    outs = ["alpine-vs-platform.tar.gz"],
    cmd = """
set -euo pipefail
SOURCE_DATE_EPOCH=0 tar --sort=name --mtime=@0 \
  --owner=0 --group=0 \
  -czf $(OUTS) -C $$(dirname $(location :all_srcs)) .
""",
    tags = ["manual", "platform"],
    visibility = ["//visibility:public"],
)

